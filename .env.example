# ============================================================
# LOCAL DEVELOPMENT — Compose image version overrides
#
# Copy this file to .env (git-ignored) to override the default image tags
# used by docker-compose.yml. The defaults below match the Azure production
# managed-service versions and are the recommended local parity targets.
#
# Production baseline (Azure):
#   PostgreSQL  – Neon 18.4          (Azure Container App secret: POSTGRES_URL)
#   MongoDB     – Atlas 8.0.26       (Azure Container App secret: MONGODB_URI)
#   Kafka       – Aiven (CP 8.2.0 local parity; exact Aiven engine version pending)
#   Redis       – Upstash 1.17.11 / Redis 8.2.0 (Azure Container App secret: REDIS_URL)
# ============================================================

POSTGRES_IMAGE=postgres:18.4
MONGO_IMAGE=mongo:8.0.26
KAFKA_IMAGE=confluentinc/cp-kafka:8.2.0
REDIS_IMAGE=redis:8.2.0-alpine
