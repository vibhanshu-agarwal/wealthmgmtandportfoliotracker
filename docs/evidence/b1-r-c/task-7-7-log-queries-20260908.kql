// Fixed-window catalog tuple query. UTF-8 query SHA-256: cdcccd73f92f6ee88e61d65dcf288b66c6d94ddcbc5000cf3d0231f11f789403
let endBound=datetime(2026-09-08T17:50:18.132Z); let targets=datatable(app:string,rev:string,start:datetime)['portfolio-service','portfolio-service--0000095',datetime(2026-09-07T15:18:47Z),'market-data-service','market-data-service--0000079',datetime(2026-08-30T10:39:21Z),'insight-service','insight-service--0000079',datetime(2026-08-30T10:39:20Z)]; ContainerAppConsoleLogs_CL | extend app=tostring(ContainerAppName_s),rev=tostring(RevisionName_s),msg=tostring(Log_s) | lookup kind=inner targets on app,rev | where TimeGenerated >= start and TimeGenerated < endBound | where msg has 'catalog_loaded' | summarize arg_max(TimeGenerated,msg) by app,rev | project TimeGenerated,app,rev,msg | order by app asc

// Fixed-window bounded marker query. UTF-8 query SHA-256: 65e0e42b07815705920af2f6dd8f8d1b21a80f98f14a89735ab27e3f4c16578d
let endBound=datetime(2026-09-08T17:50:18.132Z); let targets=datatable(app:string,rev:string,start:datetime)['portfolio-service','portfolio-service--0000095',datetime(2026-09-07T15:18:47Z),'market-data-service','market-data-service--0000079',datetime(2026-08-30T10:39:21Z),'insight-service','insight-service--0000079',datetime(2026-08-30T10:39:20Z)]; ContainerAppConsoleLogs_CL | extend app=tostring(ContainerAppName_s),rev=tostring(RevisionName_s),msg=tostring(Log_s) | lookup kind=inner targets on app,rev | where TimeGenerated >= start and TimeGenerated < endBound | extend marker=case(msg has 'catalog_load_failed','catalog_load_failed',msg has 'post_migration_integrity_failed','post_migration_integrity_failed',msg has 'unsupported_asset_event_rejected','unsupported_asset_event_rejected',msg has 'would_reject_unsupported_event','would_reject_unsupported_event',msg has ' ERROR ' or msg has 'Exception','error_or_exception','other') | where marker != 'other' | summarize occurrences=count(),first_seen=min(TimeGenerated),last_seen=max(TimeGenerated) by app,rev,marker | order by app asc,marker asc
