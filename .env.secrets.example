# ===========================================================================
# CONFIG INDEX — the one place to look
# ===========================================================================
#
# Copy to .env.secrets (gitignored) and fill in. `scripts/sync-secrets.sh .env.secrets` uploads
# the result to GitHub Actions secrets via `gh secret set -f`, which pushes EVERY key in the file
# with no per-key exclusion.
#
# Two rules, and they run in one direction only:
#   - Every key set in .env.secrets MUST appear here. No exceptions.
#   - This file MAY carry keys that are not set in .env.secrets: GitHub-only secrets, values that
#     are not secret, dead keys pending removal. Each such key says which case it is.
#
# Non-secret values are given literally here rather than blanked, so config stays traceable from
# one place. This file is allowlisted in .gitleaks.toml precisely so it can hold them.
#
# ---------------------------------------------------------------------------
# Config that necessarily lives OUTSIDE this file
# ---------------------------------------------------------------------------
# Listed so everything is at least traceable from here, even when it cannot be set from here.
#
#   frontend/.env.local            Local dev only. NEXT_PUBLIC_DEMO_EMAIL, NEXT_PUBLIC_DEMO_PASSWORD,
#                                  NEXT_PUBLIC_API_BASE_URL. NEXT_PUBLIC_* is inlined into the
#                                  client bundle at build time, so these are public by definition.
#
#   .github/workflows/*.yml        Build-time env for the GitHub runner, which never reads this
#                                  file. Anything referenced as ${{ secrets.X }} is documented
#                                  here; a few non-secret literals stay in the workflow (see the
#                                  demo-account block below for the reasoning).
#
#   */src/main/resources/          Spring per-profile defaults (local, prod, aws, azure, bedrock).
#     application-*.yml            Non-secret wiring: ports, topic names, timeouts. Secrets are
#                                  injected as env vars sourced from the keys below.
#
#   docker-compose.yml             Local stack topology and dev-only credentials.
#
#   infrastructure/terraform/      SECRETS: fully covered here. Every TF_VAR_* in terraform.yml and
#     aws/ and azure/              terraform-azure.yml is fed from a `secrets.*` documented below,
#                                  or from workflow context (github.sha, workflow_dispatch inputs).
#                                  No Terraform secret is set from a literal or a tfvars file in CI.
#                                  Audited 2026-08-15.
#
#                                  NON-SECRET config is NOT covered here and cannot be -- it is HCL,
#                                  not env vars, so it has no key to document:
#                                    - ~42 root-module `variable` blocks carry defaults in *.tf
#                                      (30 aws, 12 azure): regions, instance classes, replica
#                                      counts, feature flags.
#                                    - aws/localstack.tfvars is a REAL committed tfvars used by
#                                      `-var-file` for LocalStack integration runs.
#                                    - {aws,azure}/terraform.tfvars.example document a further set
#                                      for manual runs: environment, location, openai_location,
#                                      openai_deployment_capacity, image_tag, api_gateway_min_replicas.
#                                    - backend-aws.hcl / backend-localstack.hcl hold backend config;
#                                      backend-azure.hcl is written at runtime from AZURE_BACKEND_HCL.
#                                  Do not copy these here -- duplicating HCL defaults into env keys
#                                  recreates the drift problem. Read them at the source.
#
#   db/migration/V*.sql            Seeded identities. Flyway migrations are IMMUTABLE once applied,
#                                  so a credential established in a migration cannot be rotated by
#                                  changing any value in this file -- it needs a new migration.
#
# ===========================================================================

# Terraform Backend (Bootstrap)
TF_STATE_BUCKET=vibhanshu-tf-state-2026
TF_LOCK_TABLE=vibhanshu-terraform-locks

# App Infrastructure Secrets
POSTGRES_CONNECTION_STRING=
MONGODB_CONNECTION_STRING=
AUTH_JWK_URI=
CLOUDFRONT_ORIGIN_SECRET=
# Redis (Upstash or ElastiCache) — used by api-gateway rate limiting and insight-service caching.
# Format: redis://[:password@]host[:port]  or  rediss://... for TLS (Upstash requires rediss://)
REDIS_URL=
# Kafka credentials — used by portfolio-service, market-data-service, and insight-service.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# RDS (required by Terraform plan/apply — GitHub secret names must match)
RDS_MASTER_USERNAME=
RDS_MASTER_PASSWORD=

# AWS Credentials (if not using OIDC)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Warming — EventBridge Rules + API Destinations (Phase 2)
# TF_VAR_ENABLE_WARMING: "true" creates the 4 warming rules on next CI apply.
# TF_VAR_WARMING_ALARM_EMAIL: receives the SNS ConcurrentExecutions alert; must confirm subscription after first apply.
TF_VAR_ENABLE_WARMING=true
TF_VAR_WARMING_ALARM_EMAIL=

# ---------------------------------------------------------------------------
# Api-gateway downstream (PORTFOLIO / MARKET_DATA / INSIGHT)
# ---------------------------------------------------------------------------
# Day Zero (laptop): same default ports as Spring local / Compose published ports — no URL
# shape change when you move from `.env.secrets` to app defaults; only the host changes in cloud.
PORTFOLIO_SERVICE_URL=http://localhost:8081
MARKET_DATA_SERVICE_URL=http://localhost:8082
INSIGHT_SERVICE_URL=http://localhost:8083
#
# GitHub Actions / AWS Lambda: replace with each service’s HTTPS Lambda Function URL, e.g.
#   https://xxxxxxxx.lambda-url.<region>.on.aws/
# (from `terraform output` or Lambda → Configuration → Function URL.)
#
# Optional local “single stub” pattern (one process on :8080): set all three to http://localhost:8080
#
# Api-gateway running inside Docker Compose: use service DNS names (not localhost), e.g.
#   http://portfolio-service:8081 — see docker-compose.yml for the gateway service env.
#
# WARNING: ./scripts/sync-secrets.sh .env.secrets runs `gh secret set -f` and uploads every
# KEY=value in the file to the GitHub repo. Do not sync localhost URLs to a production repository;
# use real Function URLs (and other prod secrets) before syncing for prod.

# ---------------------------------------------------------------------------
# Azure — Phase 4 (Azure Container Apps deployment)
# ---------------------------------------------------------------------------
# OIDC identity for azure/login@v2 in deploy-azure.yml and terraform-azure.yml.
# These come from an Azure App Registration with a federated credential pointing
# at this GitHub repo. See docs/runbooks/AZURE_SECRETS_SETUP.md for setup steps.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# Terraform remote state backend for infrastructure/terraform/azure/.
# Copy infrastructure/terraform/azure/backend-azure.hcl.example to
# backend-azure.hcl, fill in real values, then paste the entire file content
# here as a single-line or multi-line value.
# The terraform-azure.yml apply path writes this secret to backend-azure.hcl
# before running terraform init.
# Format: multi-line HCL, e.g.:
#   resource_group_name  = "wealth-tf-state-rg"
#   storage_account_name = "wealthtfstate"
#   container_name       = "tfstate"
#   key                  = "azure/terraform.tfstate"
AZURE_BACKEND_HCL=

# ---------------------------------------------------------------------------
# Datasource credentials (Neon Postgres)
# ---------------------------------------------------------------------------
# POSTGRES_CONNECTION_STRING above is the JDBC URL only (jdbc:postgresql://host/db?...).
# Neon requires the user and password separately; Spring binds them to the datasource.
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# ---------------------------------------------------------------------------
# AWS runtime identifiers (standby deployment target)
# ---------------------------------------------------------------------------
# AWS is a standby target; Azure is the active production cloud (CLOUD_PROVIDER below).
# These are consumed by Terraform and the AWS deploy workflow.
AWS_DEFAULT_REGION=ap-south-1
AWS_REGION=ap-south-1
ACCOUNT_ID=
DOMAIN_NAME=
ACM_CERTIFICATE_ARN=
ECR_REPOSITORY_NAME_PORTFOLIO=
ECR_REPOSITORY_NAME_MARKET_DATA=
ECR_REPOSITORY_NAME_INSIGHT=
LAMBDA_FUNCTION_NAME_API_GATEWAY=
LAMBDA_FUNCTION_NAME_PORTFOLIO=
LAMBDA_FUNCTION_NAME_MARKET_DATA=
LAMBDA_FUNCTION_NAME_INSIGHT=

# ---------------------------------------------------------------------------
# Cloud selection
# ---------------------------------------------------------------------------
# Gates which deploy and synthetic-monitoring jobs run. Mirrored as the GitHub repository
# variable `CLOUD_PROVIDER` (a variable, not a secret) — both must agree, or a job will run
# against the wrong cloud or not run at all.
CLOUD_PROVIDER=azure

# ---------------------------------------------------------------------------
# Test / demo accounts
# ---------------------------------------------------------------------------
# E2E account — used by Playwright synthetic monitoring and the Golden-State seeder.
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=
#
# Demo (recruiter) account — NOT A SECRET. Real values given below on purpose.
#
# The demo password is public by design: deploy-azure.yml passes it as NEXT_PUBLIC_DEMO_PASSWORD,
# and Next.js inlines every NEXT_PUBLIC_* var into the client bundle. The frontend is a public
# static export, so this value already ships in the site's JavaScript and is pre-filled into the
# login form for recruiters. That is the feature. Recording it here costs no confidentiality and
# makes the config traceable from one place, which is the point of this file.
#
# CONFIGURED ELSEWHERE — and why this file cannot be the source of truth for it:
#
#   1. AUTHORITY (what the login actually validates against): a bcrypt hash in
#      portfolio-service/src/main/resources/db/migration/V15__Reconcile_Auth_Seed_Users.sql
#      Flyway migrations are immutable once applied, so editing the plaintext ANYWHERE -- here,
#      the workflow, or .env.local -- does NOT rotate the password. It only desynchronises that
#      copy from the stored hash, and the demo login then fails silently. Rotating requires a NEW
#      migration updating `user_credentials`; change every copy below in the same PR.
#
#   2. .github/workflows/deploy-azure.yml — hardcoded literal, intentionally. NEXT_PUBLIC_* vars
#      must exist at `npm run build` time inside the GitHub runner, which never reads this file.
#      Left as a literal rather than a repo secret because GitHub masks secret values as *** in
#      workflow logs, and masking a value printed on the website hinders debugging while falsely
#      implying sensitivity.
#
#   3. frontend/.env.local — local dev only; keep in step with the values here.
#
#   4. frontend/src/app/(auth)/login/page.tsx — the reader, at build time.
#
# NOTE: if you copy these keys into .env.secrets, scripts/sync-secrets.sh (`gh secret set -f`)
# uploads EVERY key in that file with no per-key exclusion, so they would become GitHub Actions
# secrets. Harmless, but pointless -- nothing reads them from there.
DEMO_EMAIL=demo@wealthtracker.dev
DEMO_PASSWORD=demo-wealthtracker-2026

# ---------------------------------------------------------------------------
# Live-test toggles
# ---------------------------------------------------------------------------
# "true" lets Bedrock-backed tests call the real service and incur cost. Default off.
RUN_BEDROCK_LIVE_TESTS=false

# ---------------------------------------------------------------------------
# Config that CANNOT live in this file — recorded here so the gap is visible
# ---------------------------------------------------------------------------
# Azure service-principal / subscription values (AZURE_CLIENT_ID, AZURE_TENANT_ID,
# AZURE_SUBSCRIPTION_ID, AZURE_BACKEND_HCL) are present in the real .env.secrets and synced
# as GitHub secrets, but Terraform's azurerm backend is configured at `init` time via
# -backend-config=backend-azure.hcl and cannot read this file.
#
# Demo password bcrypt hash — V15 migration, see the Demo account block above.
#
# GitHub repository VARIABLE `CLOUD_PROVIDER` — a variable, not a secret, so
# ./scripts/sync-secrets.sh does not manage it. Set it in the repo settings UI.

# ---------------------------------------------------------------------------
# GitHub Actions secrets — consumed by workflows, not by the running app
# ---------------------------------------------------------------------------
# These are referenced as ${{ secrets.X }} in .github/workflows/. They are listed here
# because a workflow that references a missing secret fails at run time with an empty
# value rather than an error, so an undocumented one is invisible until CI breaks.
# Several are AWS-only (the standby target) and are not needed while CLOUD_PROVIDER=azure.

# JWT signing secret used by api-gateway. Also passed as TF_VAR_AUTH_JWT_SECRET.
AUTH_JWT_SECRET=

# Shared key gating /api/internal/** (the Golden-State seed endpoints). Each downstream
# service validates it via InternalApiKeyFilter; the seed jobs send it as X-Internal-Api-Key.
TF_VAR_INTERNAL_API_KEY=

# E2E account identity. Complements E2E_TEST_USER_EMAIL / _PASSWORD above — Terraform seeds
# the user row with these, so all four must describe the same account.
E2E_TEST_USER_ID=
E2E_TEST_USER_NAME=

# Azure Static Web Apps deployment token — frontend deploy in deploy-azure.yml.
SWA_DEPLOYMENT_TOKEN=

# JetBrains Qodana cloud token — code-quality workflow only.
QODANA_TOKEN=

# --- AWS standby target only (unused while CLOUD_PROVIDER=azure) ---
AWS_ACCOUNT_ID=
S3_BUCKET_NAME=
CLOUDFRONT_DISTRIBUTION_ID=
TF_ARTIFACT_BUCKET=
# NOTE: a bare ECR_REPOSITORY_NAME is consumed by deploy-aws.yml and terraform.yml in
# addition to the three per-service ECR_REPOSITORY_NAME_* keys above. Confirm whether the
# bare form is still required or is leftover from before the repositories were split.
ECR_REPOSITORY_NAME=

# --- Dead: do not set; pending removal ---
# NEXTAUTH_SECRET had exactly two consumers, both mapping it to BETTER_AUTH_SECRET:
# ci-verification.yml and frontend-e2e-integration.yml. Better Auth was retired in PR #88
# (ba_* tables dropped in V16, dependency and frontend code removed) and nothing in src/, the
# Vitest suite, or the Next.js build reads either name -- independently confirmed, and already
# recorded during the PR #85 cleanup that fixed frontend-ci.yml but missed these two workflows.
# Both mappings are now commented out in place rather than deleted, so they stay greppable
# instead of turning into a runtime error nobody can trace back. Delete this key, the two
# commented blocks, and the repository secret together once a green run confirms the absence.
# NEXTAUTH_SECRET=
